<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_detail_info_dialog"
    android:padding="20dp">

    <TextView
        android:id="@+id/detailInfoTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Detail Info"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.stx.xhb.xbanner.XBanner
        android:id="@+id/detailInfoBanner"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="16dp"
        app:isAutoPlay="false"
        app:isShowIndicatorOnlyOne="true"
        app:pointNormal="@drawable/shape_point_normal"
        app:pointSelect="@drawable/shape_point_select"
        app:pointsPosition="CENTER" />

    <Button
        android:id="@+id/detailInfoClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Close" />

</LinearLayout>
